# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Admin panel, admin API and Swagger (never expose this port to the internet)
ADMIN_PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/sortund

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change_me_to_a_different_secure_random_secret_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI worker ───────────────────────────────────────────────────────────────
AI_WORKER_URL=http://localhost:8000
# Must match WORKER_TOKEN of the AI worker (empty = no auth, local only)
AI_WORKER_TOKEN=
ANALYSIS_CONCURRENCY=2

# ─── Users ───────────────────────────────────────────────────────────────────
DEFAULT_MONTHLY_ANALYSIS_LIMIT=100
# Comma-separated list of e-mails that get the admin role
ADMIN_EMAILS=admin@example.com

# ─── Push notifications (optional Expo access token) ─────────────────────────
EXPO_ACCESS_TOKEN=
