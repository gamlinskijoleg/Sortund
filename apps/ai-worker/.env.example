# Shared secret; the backend sends it in the X-Worker-Token header (must equal AI_WORKER_TOKEN of the backend).
# Leave empty only for local development.
WORKER_TOKEN=

# Optional Hugging Face token (model download rate limits)
HF_TOKEN=

# Genre model
DEFAULT_GENRE_MODEL_VERSION=v1
GENRE_AUDIO_WEIGHT=0.8
GENRE_REGULARIZATION=0.01

# Lyrics transcription fallback (faster-whisper); "small" is a good CPU trade-off
ENABLE_WHISPER=true
WHISPER_MODEL=small

# Confidence thresholds (0..1) below which tags are dropped
TAG_THRESHOLD=0.35
INSTRUMENT_THRESHOLD=0.12
STYLE_THRESHOLD=0.15
THEME_THRESHOLD=0.2
VOCAL_THRESHOLD=0.02
